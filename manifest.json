{
  "manifest_version": 3,
  "name": "Grammar Coach (Anti-Grammarly)",
  "version": "0.1.0",
  "description": "Тренажер грамотного письма на RU и EN без автозамены",
  "permissions": ["storage", "alarms"],
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content-script.ts"],
      "run_at": "document_idle"
    }
  ]
}
